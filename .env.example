# Application
APP_NAME=Fashion-Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# 日志级别
LOG_LEVEL=INFO

# OpenAI 兼容接口地址
# DeepSeek 示例：https://api.deepseek.com
LLM_BASE_URL=

# 模型服务密钥
# 这里只保留空值，不要填写真实密钥
LLM_API_KEY=

# 模型名称
# DeepSeek 示例：deepseek-chat
LLM_MODEL=

# 天气 Provider，可选 disabled 或 open_meteo
# 公共 Open-Meteo 端点只适合非商业原型；生产环境需确认授权并配置客户或自托管端点
WEATHER_PROVIDER_BACKEND=disabled
WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
WEATHER_FORECAST_BASE_URL=https://api.open-meteo.com

# Open-Meteo 商业客户密钥；不要把真实密钥写入本文件
WEATHER_API_KEY=

# 单次天气 HTTP 请求超时秒数，必须大于 0 且不超过 60 秒
WEATHER_TIMEOUT_SECONDS=10

# 商品仓库后端，可选 memory 或 postgres
PRODUCT_REPOSITORY_BACKEND=memory

# PostgreSQL Docker 容器初始化配置
# 这里只能填写本地开发示例值，生产环境必须使用安全密码
POSTGRES_DB=fashion_agent
POSTGRES_USER=fashion_agent
POSTGRES_PASSWORD=fashion_agent_dev

# PostgreSQL 异步连接地址
# 用户名、密码和数据库名需要与上面的容器配置保持一致
DATABASE_URL=postgresql+asyncpg://fashion_agent:fashion_agent_dev@localhost:5432/fashion_agent

# 是否输出 SQLAlchemy 执行的 SQL
DATABASE_ECHO=False

# Redis 连接地址，后续阶段使用
REDIS_URL=

# 本地中文 Embedding 模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 运行设备：cpu 或 cuda
EMBEDDING_DEVICE=cpu

# Chroma 持久化数据保存目录
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Chroma 服装知识集合名称
CHROMA_COLLECTION_NAME=fashion_knowledge

# 独立知识库根目录；应用只读取其中的正式发布内容
KNOWLEDGE_REPOSITORY_PATH=./data/raw/Fashion-Agent-Knowledge

# 相对知识库根目录的正式发布 Manifest
KNOWLEDGE_RELEASE_MANIFEST=releases/manifests/fashion-knowledge-2.8.0.yaml

# RAG 文档切分大小
RAG_CHUNK_SIZE=400

# RAG 相邻片段重叠大小
RAG_CHUNK_OVERLAP=50

# 每次检索返回的片段数量
RAG_TOP_K=3

# 向量初筛候选数量，必须不小于最终返回数量
RAG_CANDIDATE_K=24

# Retriever 返回后最多允许进入 Agent State 的知识片段数
RAG_CONTEXT_MAX_DOCUMENTS=3

# 单个检索片段允许进入 Agent State 的最大字符数
RAG_CONTEXT_MAX_FRAGMENT_CHARS=1200

# 全部检索片段允许进入 Agent State 的总字符上限
RAG_CONTEXT_MAX_CHARS=4000

# 单次模型调用可注入的外部上下文字符预算
# 不包含当前用户消息、固定系统规则和结构化输出 Schema
AGENT_CONTEXT_MAX_CHARS=12000

# 用户明确维护的长期档案、上一套 Outfit 等明确记忆预算
AGENT_EXPLICIT_MEMORY_MAX_CHARS=3000

# 对话摘要、近期 Outfit 和反馈等历史记忆预算
AGENT_HISTORICAL_MEMORY_MAX_CHARS=3000

# 单次模型调用允许注入的 RAG 知识预算
AGENT_KNOWLEDGE_MAX_CHARS=4000

# 发送给聊天模型的最近完整对话轮数
# 当前轮消息和未完成的工具调用链始终整体保留
AGENT_HISTORY_MAX_TURNS=6

# 发送给聊天模型的短期对话历史字符预算
AGENT_HISTORY_MAX_CHARS=8000

# 已退出最近消息窗口的提取式滚动摘要字符预算
# 摘要只帮助理解连续意图，不作为衣橱、商品或天气事实
AGENT_SUMMARY_MAX_CHARS=2000
