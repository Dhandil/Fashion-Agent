# Application
APP_NAME=Fashion-Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# 日志级别
LOG_LEVEL=INFO

# OpenAI 兼容接口地址
# DeepSeek 示例：https://api.deepseek.com
LLM_BASE_URL=

# 模型服务密钥
# 这里只保留空值，不要填写真实密钥
LLM_API_KEY=

# 模型名称
# DeepSeek 示例：deepseek-chat
LLM_MODEL=

# Persistence
POSTGRES_DSN=
REDIS_URL=
CHROMA_PERSIST_DIRECTORY=./data/chroma

# 本地中文 Embedding 模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 运行设备：cpu 或 cuda
EMBEDDING_DEVICE=cpu

# Chroma 持久化数据保存目录
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Chroma 服装知识集合名称
CHROMA_COLLECTION_NAME=fashion_knowledge

# RAG 文档切分大小
RAG_CHUNK_SIZE=400

# RAG 相邻片段重叠大小
RAG_CHUNK_OVERLAP=50

# 每次检索返回的片段数量
RAG_TOP_K=3