# ==============================
# RAG 运行时数据
# ==============================

# 独立原始知识库不进入 Fashion-Agent 仓库
/data/raw/**

# 保留 raw 空目录占位文件
!/data/raw/.gitkeep

# Chroma 向量、索引和本地数据库不提交
/data/chroma/**

# 处理过程中生成的数据不提交
/data/processed/**

# 保留 processed 空目录占位文件
!/data/processed/.gitkeep


# ==============================
# Hugging Face 与模型缓存
# 防止模型权重被意外提交
# ==============================

.cache/
huggingface/
models/
*.safetensors
*.bin


